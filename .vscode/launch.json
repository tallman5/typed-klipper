{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Vitest Current Test",
            "runtimeExecutable": "npx",
            "runtimeArgs": [
                "--inspect-brk"
            ],
            "args": [
                "vitest",
                "run",
                "${fileBasenameNoExtension}"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "cwd": "${workspaceFolder}"
        }
    ]
}
